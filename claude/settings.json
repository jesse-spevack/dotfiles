{
  "enabledPlugins": {
    "planbridge@contextbridge": true,
    "vercel@claude-plugins-official": false,
    "hey@37signals": true
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "fastMode": true,
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "model": "claude-fable-5[1m]",
  "extraKnownMarketplaces": {
    "37signals": {
      "source": {
        "source": "github",
        "repo": "basecamp/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Concise"
}
